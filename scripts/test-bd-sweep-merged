#!/usr/bin/env bash
# Tests for bd-sweep-merged's delivery-citation match, for the timestamp rule
# that decides when a citation is only context, and for the open-PR cross-check
# that has to corroborate the pre-close search before a bead closes.
#
# Together they decide whether a merged PR closes a bead, and both ways that can
# be wrong are expensive:
#
#   - too strict, and shipped work never closes. A double-escaped dot
#     (gsub("\."; "\\.") in jq source) turned every dotted child id into a regex
#     demanding a literal backslash, so acme-qtdma.{1,4,5,8} sat in in_review
#     with four merged PRs citing them in the branch name AND on a Bead: line,
#     and had to be closed by hand.
#   - too loose, and unshipped work gets marked delivered: an unescaped dot is a
#     regex wildcard, body prose routinely names beads a PR only FILED as
#     follow-ups, and a parent id must not match its own children.
#
# The tests below are ordered by which failure would hurt most, and every one of
# them runs offline: the script is sourced with BD_SWEEP_MERGED_LIB=1, which
# defines cites_bead and stops before any bd or GitHub call.
#
# Run: scripts/test-bd-sweep-merged

set -uo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=/dev/null
BD_SWEEP_MERGED_LIB=1 . "$SCRIPT_DIR/bd-sweep-merged"

FAILED=0
pass() { printf '  ok   %s\n' "$1"; }
fail() { printf '  FAIL %s\n     %s\n' "$1" "$2"; FAILED=$((FAILED + 1)); }

pr_json() {
    # pr_json <title> <branch> <body>
    jq -nc --arg t "$1" --arg h "$2" --arg b "$3" \
        '{title: $t, headRefName: $h, body: $b, state: "MERGED"}'
}

check() {
    # check <expected true|false> <bead-id> <title> <branch> <body> <name>
    local want=$1 id=$2 name=$6 got
    got=$(pr_json "$3" "$4" "$5" | cites_bead "$id")
    if [ "$got" = "$want" ]; then
        pass "$name"
    else
        fail "$name" "cites_bead $id returned '$got', expected '$want'"
    fi
}

echo "bd-sweep-merged citation tests"

# --- 1. dotted child ids, the regression --------------------------------
# All three citation sites, with the dot that used to break every one of them.
check true acme-qtdma.1 \
    "fix the sweep" "acme-qtdma.1-fix-the-sweep" "does what it says" \
    "a dotted child id in the branch name cites the bead"
check true acme-qtdma.1 \
    "acme-qtdma.1: fix the sweep" "some-branch" "does what it says" \
    "a dotted child id in the title cites the bead"
check true acme-qtdma.1 \
    "fix the sweep" "some-branch" $'why\n\nBead: acme-qtdma.1\n' \
    "a dotted child id on a Bead: line cites the bead"
check true acme-qtdma.1 \
    "fix the sweep" "some-branch" $'why\n\n**Beads:** acme-qtdma.1, acme-qtdma.4\n' \
    "a dotted child id in a decorated Beads: list cites the bead"
check true acme-qtdma.1 \
    "fix the sweep" "ACME-QTDMA.1-fix" "why" \
    "citation matching stays case-insensitive for dotted ids"

# --- 2. the dot is escaped, not a wildcard -------------------------------
# The reason the gsub exists at all. Without escaping these two would pass as
# citations and close beads whose work never shipped.
check false acme-qtdma.1 \
    "fix the sweep" "acme-qtdmax1-fix" "why" \
    "the dot does not match another character in the branch"
check false acme-qtdma.1 \
    "fix the sweep" "some-branch" $'Bead: acme-qtdma-1\n' \
    "the dot does not match a hyphen on a Bead: line"

# --- 3. boundaries between a parent and its children ---------------------
check false acme-qtdma \
    "fix the sweep" "acme-qtdma.1-fix" $'Bead: acme-qtdma.1\n' \
    "a parent id is not cited by a PR that cites only a child"
check false acme-qtdma.1 \
    "fix the sweep" "acme-qtdma.12-fix" $'Bead: acme-qtdma.12\n' \
    "a child id is not cited by a PR that cites a longer sibling id"
check false acme-qtdm \
    "fix the sweep" "acme-qtdma-fix" $'Bead: acme-qtdma\n' \
    "an id is not cited by a PR citing an id it is a prefix of"

# --- 4. body prose is context, never delivery ---------------------------
# acme-it9d: a parent feature's merged PR listed its follow-up beads in prose
# and the sweep closed them while their real PRs were still open.
check false acme-qtdma.1 \
    "fix something else" "some-branch" $'Follow-up beads: acme-qtdma.1 covers the rest.\n' \
    "a dotted id named in body prose is context, not a citation"
check false acme-x7q2 \
    "fix something else" "some-branch" $'Prior art: acme-x7q2\n' \
    "an undotted id named in body prose is context, not a citation"

# --- 5. plain undotted ids still work -----------------------------------
check true acme-x7q2 \
    "fix the sweep" "acme-x7q2-fix-the-sweep" "why" \
    "an undotted id in the branch name cites the bead"
check true acme-x7q2 \
    "fix the sweep" "some-branch" $'why\n\nBead: acme-x7q2\n' \
    "an undotted id on a Bead: line cites the bead"
check false acme-x7q2 \
    "fix the sweep" "some-branch" "nothing to see here" \
    "a PR that cites nothing closes nothing"

# --- 6. a merged PR that predates the work is context, not delivery ------
# acme-k2zxt: api#1007 merged on 2026-08-11 and named acme-kdod in its
# title as the sibling lane it had already shipped; the bead's own work started
# on 2026-08-17 and its real PR was still an open draft when the sweep closed it.
time_check() {
    # time_check <expected true|false> <merged-at> <bead-started> <name>
    local want=$1 name=$4 got=false
    merged_before_start "$2" "$3" && got=true
    if [ "$got" = "$want" ]; then
        pass "$name"
    else
        fail "$name" "merged_before_start '$2' '$3' returned '$got', expected '$want'"
    fi
}

time_check true 2026-08-11T22:34:20Z 2026-08-17T13:05:00Z \
    "a PR merged days before the bead started does not deliver it"
time_check false 2026-08-17T18:08:19Z 2026-08-17T13:05:00Z \
    "a PR merged after the bead started delivers it"
time_check false 2026-08-17T09:00:00Z 2026-08-17T13:05:00Z \
    "same-day slack: merging just before the bead is moved still delivers it"
time_check false 2026-08-11T22:34:20Z "" \
    "a bead with no recorded start discounts nothing"
time_check false "" 2026-08-17T13:05:00Z \
    "a PR with no merge time discounts nothing"
time_check false 2026-08-11T22:34:20+02:00 2026-08-17T13:05:00Z \
    "a timestamp that is not plain UTC is not compared at all"

# --- 7. the open-PR cross-check reads the index correctly ----------------
# The pre-close GitHub search can succeed and answer incompletely (index lag,
# GraphQL outage), which is indistinguishable from a clean empty answer, so a
# REST list of open PRs corroborates it. This filter is where that
# list turns into a verdict, and it is judged in one jq pass over the whole
# index — so what has to hold is that each verdict lands on ITS OWN PR, and that
# an index it cannot read says "could not tell" rather than "nothing found".
idx_line() {
    # idx_line <owner/repo> <number> <title> <branch> <body>
    printf '%s\t%s\t%s\n' "$1" "$2" \
        "$(jq -nc --arg t "$3" --arg h "$4" --arg b "$5" \
            '{title: $t, body: $b, headRefName: $h}')"
}

index_check() {
    # index_check <expected stdout> <expected rc> <bead-id> <index> <name>
    local want=$1 want_rc=$2 id=$3 index=$4 name=$5 got rc
    got=$(printf '%s' "$index" | filter_citing_prs "$id")
    rc=$?
    if [ "$got" = "$want" ] && [ "$rc" = "$want_rc" ]; then
        pass "$name"
    else
        fail "$name" "got rc=$rc out='$got', expected rc=$want_rc out='$want'"
    fi
}

# acme-kdod's shape: the delivering PR is open, cites the bead in title and
# branch, and the search never returned it.
index_check "$(printf 'acme/api\t1244')" 0 acme-kdod \
    "$(idx_line acme/api 1244 "acme-kdod: fix the sweep" \
        "acme-kdod-fix-the-sweep" "why")" \
    "an open PR citing the bead is found by the cross-check"

# Alignment: three PRs, one citation. A verdict pasted onto the wrong row would
# block the wrong bead or, worse, clear this one.
index_check "$(printf 'acme/web\t951')" 0 acme-x7q2 \
    "$(idx_line acme/api 1244 "something else" "other-branch" "why"
       idx_line acme/web 951 "fix it" "acme-x7q2-fix-it" $'why\n\nBead: acme-x7q2\n'
       idx_line acme/worker 77 "third" "third-branch" "why")" \
    "each verdict lands on its own PR in a multi-repo index"

index_check "" 0 acme-x7q2 \
    "$(idx_line acme/api 1244 "fix something else" "other-branch" \
        $'Follow-up beads: acme-x7q2 covers the rest.\n')" \
    "an open PR that only mentions the bead in prose does not block a close"

index_check "" 0 acme-x7q2 "" \
    "an index with no open PRs answers 'none', not an error"

# The one that must not fail open: an unreadable row ends jq's stream, so the
# verdicts no longer line up with the PRs and the honest answer is "could not
# tell" — which the caller turns into DEGRADED, leaving the bead open.
index_check "" 1 acme-x7q2 \
    "$(idx_line acme/api 1244 "fix it" "acme-x7q2-fix-it" "why"
       printf 'acme/web\t951\t{not json\n'
       idx_line acme/worker 77 "third" "third-branch" "why")" \
    "an index line jq cannot parse is 'could not tell', not 'nothing found'"

# --- 8. a body-less PR is answerable, not a crash ------------------------
got=$(jq -nc '{title: "acme-x7q2: fix", headRefName: "b", state: "MERGED"}' | cites_bead acme-x7q2)
case "$got" in
    true) pass "a PR with no body field is still matched on title and branch" ;;
    *) fail "a PR with no body field is still matched on title and branch" "returned '$got'" ;;
esac

# --- 9. the reverse audit's citation extractor ---------------------------
#
# The audit reports a merged PR whose bead is still `open` or
# does not exist at all, so it has to agree with cites_bead
# about what a delivery citation IS. Reading a body-prose mention as a
# delivery would report every follow-up bead a PR filed as leaked work, and
# missing a title or branch citation would report nothing at all.
cited_ids() {
    printf '%s' "$1" | delivery_cited_ids acme | tr '\n' ' ' | sed 's/ $//'
}

audit_check() {
    expected=$1; description=$2; payload=$3
    got=$(cited_ids "$payload")
    if [ "$got" = "$expected" ]; then
        pass "$description"
    else
        fail "$description" "extracted '$got', expected '$expected'"
    fi
}

audit_check "acme-x7q2" \
    "a title citation is a delivery citation" \
    "$(jq -nc '{title: "fix(x): thing (acme-x7q2)", headRefName: "fix/thing", body: ""}')"

audit_check "acme-x7q2" \
    "a branch citation is a delivery citation" \
    "$(jq -nc '{title: "fix the thing", headRefName: "fix/acme-x7q2-thing", body: ""}')"

audit_check "acme-x7q2" \
    "a Bead: line is a delivery citation" \
    "$(jq -nc '{title: "fix", headRefName: "b", body: "Some prose.\n\nBead: acme-x7q2\n"}')"

# The rule that keeps the audit from reporting every follow-up a PR filed:
# body prose is context, exactly as it is for the close path.
audit_check "" \
    "a bead named only in body prose is not extracted" \
    "$(jq -nc '{title: "fix", headRefName: "b", body: "Follow-up beads: acme-later, acme-other"}')"

audit_check "acme-a1b2 acme-c3d4" \
    "several delivery citations are all extracted" \
    "$(jq -nc '{title: "fix two (acme-a1b2)", headRefName: "b", body: "Beads: acme-a1b2, acme-c3d4"}')"

# The audit reads the same ranking as the close path (section 10): beside a
# Bead: line, a title id that line does not list is what the PR is ABOUT.
audit_check "acme-c3d4" \
    "a title id beside a Bead: line that does not list it is not extracted" \
    "$(jq -nc '{title: "fix two (acme-a1b2)", headRefName: "b", body: "Beads: acme-c3d4"}')"

audit_check "acme-qtdma.7" \
    "a dotted child id survives extraction" \
    "$(jq -nc '{title: "fix", headRefName: "b", body: "Bead: acme-qtdma.7"}')"

audit_check "" \
    "a PR citing no bead extracts nothing" \
    "$(jq -nc '{title: "chore: bump deps", headRefName: "deps", body: "routine"}')"

# The reason the prefix is required rather than inferred from the id shape.
# A generic "<word>-<word>" pattern read ordinary branch names as bead ids
# and reported a dozen phantoms per PR, which is an audit nobody reads.
audit_check "" \
    "ordinary hyphenated branch words are not bead ids" \
    "$(jq -nc '{title: "fix(agent): prune manifests", headRefName: "fix/manifest-delete-teardown-rebased", body: ""}')"

audit_check "acme-bu2ii" \
    "a real id is still found among hyphenated words" \
    "$(jq -nc '{title: "feat: auto-prune cluster-scoped resources (acme-bu2ii)", headRefName: "feat/native-release", body: ""}')"

# tracker_id_prefix reads the prefix off bd's own ids, so the script serves
# any workspace rather than hardcoding this one.
prefix_got=$(tracker_id_prefix "$(printf 'acme-a1\topen\nacme-b2\tclosed\nacme-c3.1\topen\n')")
if [ "$prefix_got" = "acme" ]; then
    pass "the tracker prefix is derived from bd's own ids"
else
    fail "the tracker prefix is derived from bd's own ids" "got '$prefix_got'"
fi

prefix_got=$(tracker_id_prefix "$(printf 'widget-a1\topen\nwidget-b2\tclosed\n')")
if [ "$prefix_got" = "widget" ]; then
    pass "another workspace's prefix is derived just as well"
else
    fail "another workspace's prefix is derived just as well" "got '$prefix_got'"
fi

# --- 10. the citation sites are ranked, not pooled (acme-d9x4e) ---------
#
# A Bead:/Beads: line, when present, IS the list of what the PR delivers.
# Without one, the title's ids are. Only when neither names a bead does the
# branch speak, and then only the id it starts with. Pooling all three is how
# a PR delivers beads it only talks about.

# acme/beads#8, verbatim where it matters. It delivers acme-ouxcd; its
# title and branch name acme-eyrqq and acme-h34rf because the allowlist line
# it adds records THOSE two as not-duplicates. Pooled, the title alone made it
# a delivery of both: the sweep had already closed eyrqq on it, and h34rf -
# open, being worked - was next in line.
BEADS_8_TITLE="dup-check: record acme-eyrqq / acme-h34rf as distinct (acme-ouxcd)"
BEADS_8_BRANCH="acme-ouxcd-2-h34rf"
BEADS_8_BODY=$'**Bead: acme-ouxcd** — follow-up to #7, first real use of the allowlist it added.\n\nAbout an hour after #7 landed, the team filed `acme-h34rf` and the check flagged it against `acme-eyrqq` at 51%. They are not duplicates: **h34rf was filed by the eyrqq job while working it.**\n\nVerified: `scripts/test-bd-dup-check` 17/17 still pass.\n'
check false acme-h34rf "$BEADS_8_TITLE" "$BEADS_8_BRANCH" "$BEADS_8_BODY" \
    "beads#8: a bead the title only talks about is not delivered by it"
check false acme-eyrqq "$BEADS_8_TITLE" "$BEADS_8_BRANCH" "$BEADS_8_BODY" \
    "beads#8: neither is the other bead its title names"
check true acme-ouxcd "$BEADS_8_TITLE" "$BEADS_8_BRANCH" "$BEADS_8_BODY" \
    "beads#8: the bead on its Bead: line is delivered"
audit_check "acme-ouxcd" \
    "beads#8: the reverse audit reads the same single delivery" \
    "$(pr_json "$BEADS_8_TITLE" "$BEADS_8_BRANCH" "$BEADS_8_BODY")"

# acme/acme-frontend#153: one PR, a parent-level bead and its four
# children, all on one Beads: line. Every one of them is delivered, and
# nothing beyond the list is.
FE_153_TITLE="feat(ink): the shared primitives on Ink: badges, states, the side sheet and choices (acme-b8vdx.6)"
FE_153_BRANCH="acme-b8vdx.6-primitives"
FE_153_BODY=$'Beads: acme-b8vdx.6, acme-b8vdx.6.1, acme-b8vdx.6.2, acme-b8vdx.6.3, acme-b8vdx.6.4\n\n## Badge and StatusPill render Ink\'s Badge\n\nBadge and StatusPill keep their names and props.\n'
for id in acme-b8vdx.6 acme-b8vdx.6.1 acme-b8vdx.6.2 acme-b8vdx.6.3 acme-b8vdx.6.4; do
    check true "$id" "$FE_153_TITLE" "$FE_153_BRANCH" "$FE_153_BODY" \
        "acme-frontend#153: $id on a multi-bead Beads: line is delivered"
done
check false acme-b8vdx "$FE_153_TITLE" "$FE_153_BRANCH" "$FE_153_BODY" \
    "acme-frontend#153: the epic above the listed beads is not"
check false acme-b8vdx.6.5 "$FE_153_TITLE" "$FE_153_BRANCH" "$FE_153_BODY" \
    "acme-frontend#153: a sibling that is not listed is not"
audit_check "acme-b8vdx.6 acme-b8vdx.6.1 acme-b8vdx.6.2 acme-b8vdx.6.3 acme-b8vdx.6.4" \
    "acme-frontend#153: the reverse audit extracts the whole Beads: line" \
    "$(pr_json "$FE_153_TITLE" "$FE_153_BRANCH" "$FE_153_BODY")"

# A title id in the FAMILY of a listed bead - its child, or the epic it belongs
# to - refines the Bead: line rather than contradicting it, and both shapes
# are common. api#3239: the line names the epic, the title the child.
check true acme-u3jsj.14 \
    "fix(cluster): the dedicated-etcd lane reaches etcdctl without assuming crictl (acme-u3jsj.14)" \
    "fix/acme-u3jsj-etcd-lane-no-crictl" $'Bead: acme-u3jsj\n' \
    "a title naming a child of the Bead: line's bead still delivers the child"
check true acme-u3jsj \
    "fix(cluster): the dedicated-etcd lane reaches etcdctl without assuming crictl (acme-u3jsj.14)" \
    "fix/acme-u3jsj-etcd-lane-no-crictl" $'Bead: acme-u3jsj\n' \
    "... and the Bead: line's own bead stays delivered"
# acme-docs#195: the title names the epic, the Beads: line its children. The
# sweep closed acme-us966 on it (with its three sibling PRs) - an epic cited
# this way still closes only once its children have (children_still_open).
check true acme-us966 \
    "docs(ai board): a blocked ticket's choice from chat, the CLI, and Slack/Teams (acme-us966)" \
    "docs/ticket-decision-parity" $'Bead: acme-us966.1, acme-us966.2, acme-us966.3\n' \
    "a title naming the epic of the Bead: line's beads still delivers the epic"
check false acme-us967 \
    "docs(ai board): follow-up to acme-us967 (acme-us966)" \
    "docs/ticket-decision-parity" $'Bead: acme-us966.1\n' \
    "... but a title id outside that family does not"

# A Bead: line that names no bead at all is not a list; the title still speaks.
check true acme-x7q2 "fix the sweep (acme-x7q2)" "b" $'Bead: n/a\n' \
    "a Bead: line naming no bead falls through to the title"

# The branch beside a title or a Bead: line. web#2072's branch carries the
# id the work was first filed under (acme-whdvi.73), whose row a tracker sync
# later handed to a different issue; its Bead: line and title say .74.
check false acme-whdvi.73 \
    "fix(stacks): a failed draft sync rollback is never sent as the user's edit (acme-whdvi.74)" \
    "fix/acme-whdvi.73-rollback-origin" $'Bead: acme-whdvi.74\n' \
    "a branch id beside a Bead: line that lists another bead is not delivered"
# acme-cli#183: a child spelled with a hyphen in the branch reads as its parent.
check false acme-0xsdd \
    "fix(backup): recovery advice that matches the vault (acme-0xsdd.28)" \
    "fix/acme-0xsdd-28-vault-recovery-advice" "why" \
    "a branch id beside a title citation is not delivered"
check true acme-0xsdd.28 \
    "fix(backup): recovery advice that matches the vault (acme-0xsdd.28)" \
    "fix/acme-0xsdd-28-vault-recovery-advice" "why" \
    "... while the title's own citation is"

# The branch alone: only the id it starts with, after `type/` segments.
check true acme-x7q2 "fix the sweep" "fix/acme-x7q2-the-sweep" "why" \
    "a branch-only citation after a type/ prefix is delivered"
check true acme-x7q2 "fix the sweep" "mattias/fix/acme-x7q2-the-sweep" "why" \
    "a branch-only citation after several path segments is delivered"
check true acme-ouxcd "record two beads" "acme-ouxcd-2-acme-h34rf" "why" \
    "the id a branch starts with is delivered"
check false acme-h34rf "record two beads" "acme-ouxcd-2-acme-h34rf" "why" \
    "a second id later in the branch is not"
check false acme-x7q2 "fix the sweep" "docs/the-sweep-acme-x7q2" "why" \
    "an id embedded after a slug in the branch is not"
check false acme-x7q2 "fix the sweep" "fix/foo-acme-x7q2/bar" "why" \
    "an id embedded inside a path segment is not"

# --- the shared GitHub budget (acme-mfhky) -------------------------------
# rate_decision is the whole policy for "may this sweep keep spending the
# token's budget": carry on, wait out a reset that is close, or stop. Its
# failure modes are both quiet — a sweep that never stops drains the budget
# every other session on the machine shares, and one that stops on a missing
# header silences a healthy run — so each edge is pinned here.
decide() {
    # decide <expected> <remaining> <limit> <reset> <now> <name>
    local got
    got=$(rate_decision "$2" "$3" "$4" "$5")
    if [ "$got" = "$1" ]; then pass "$6"; else fail "$6" "rate_decision $2 $3 $4 $5 said '$got', expected '$1'"; fi
}
unset BD_SWEEP_RATE_RESERVE_PCT BD_SWEEP_RATE_WAIT
decide ok 4553 5000 1000 900 "a healthy core budget carries on"
decide ok 501 5000 1000 900 "one above the 10% reserve still carries on"
decide stop 500 5000 4500 900 "at the reserve, an hour from reset: stop"
decide stop 0 5000 4500 900 "an exhausted budget an hour from reset: stop"
decide "wait 11" 3 30 910 900 "the search budget at its reserve, resetting in 10s: wait it out"
decide "wait 1" 0 30 890 900 "a reset already in the past waits a second, never a negative time"
decide stop 2 30 960 900 "a search reset past BD_SWEEP_RATE_WAIT: stop"
decide ok "" "" "" 900 "no budget headers is not evidence of exhaustion"
decide ok abc 5000 1000 900 "an unreadable remaining count is not either"
decide stop 0 60 "" 900 "exhausted with no readable reset: stop rather than guess"
BD_SWEEP_RATE_WAIT=90 decide "wait 61" 2 30 960 900 "BD_SWEEP_RATE_WAIT widens the wait"
BD_SWEEP_RATE_RESERVE_PCT=0 decide ok 1 5000 4500 900 "a 0% reserve spends down to the last call"

# header_value reads the budget off `gh api -i`, whose header names arrive in
# whatever case GitHub sent (HTTP/2 lowercases them, gh title-cases them) and
# whose lines end in CRLF.
HEADERS=$'Content-Type: application/json\r\nX-Ratelimit-Remaining: 4553\r\nx-ratelimit-reset: 1790686682\r\nEtag: W/"78:10"\r\n'
got=$(printf '%s' "$HEADERS" | header_value x-ratelimit-remaining)
[ "$got" = 4553 ] && pass "header_value matches a header name in any case, without its CR" ||
    fail "header_value remaining" "got '$got'"
got=$(printf '%s' "$HEADERS" | header_value x-ratelimit-reset)
[ "$got" = 1790686682 ] && pass "header_value reads a lowercase header" || fail "header_value reset" "got '$got'"
got=$(printf '%s' "$HEADERS" | header_value etag)
[ "$got" = 'W/"78:10"' ] && pass "header_value keeps a value that itself contains a colon" ||
    fail "header_value etag" "got '$got'"
got=$(printf '%s' "$HEADERS" | header_value retry-after)
[ -z "$got" ] && pass "header_value answers nothing for an absent header" || fail "header_value absent" "got '$got'"

echo
if [ "$FAILED" -eq 0 ]; then
    echo "all tests passed"
    exit 0
fi
echo "$FAILED test(s) failed"
exit 1
