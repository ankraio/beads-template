# A definitive 404 is an answer: the ref is reported MISSING, the bead stays
# open, and the run does not paint itself red. It is reported as "no PR
# recorded", not as "not all merged": a number that is not a PR in that repo
# can never merge, so the old wording promised a close that could not come.
scenario "a bead citing a deleted PR is MISSING, not DEGRADED"
bead acme-aaa 2026-08-01T00:00:00Z "delivered in api#404"
run_sweep --apply
expect_rc 0
expect_says "no PR cites this bead — its only references are not pull requests in the repo they were attributed to (MISSING: $OWNER/api#404)"
expect_silent_about "citing PRs not all merged"
expect_silent_about DEGRADED
expect_not_closed acme-aaa
finish

# acme-4ea0z: a phantom ref must not block a close. The harvester pins a
# bare "#N" in prose to the bead's one mentioned repo, so "mitigated by
# #1231" (a web PR) became worker#1231, which does not exist, and the
# MISSING entry sat in the unmerged list beside a merged, citing worker#68 -
# acme-i5ufw stayed in in_review 24 days on "citing PRs not all merged".
# A phantom is permanent, so blocking on it was "never closes".
scenario "a MISSING ref beside a merged citing PR does not block the close"
bead acme-aaa 2026-08-01T00:00:00Z "mitigated by api#404, delivered in api#100"
pr $OWNER/api 100 MERGED "acme-aaa: do the thing" acme-aaa-do-the-thing \
    "why" 2026-08-05T09:00:00Z
run_sweep --apply
expect_rc 0
expect_says "ignored, not a PR in the repo it was attributed to: $OWNER/api#404"
expect_silent_about "citing PRs not all merged"
expect_silent_about DEGRADED
expect_closed acme-aaa
finish

# ...but it authorizes nothing either: a MISSING ref beside an OPEN citing PR
# still leaves the bead open on the open PR.
scenario "a MISSING ref does not authorize a close past an open citing PR"
bead acme-aaa 2026-08-01T00:00:00Z "mitigated by api#404, delivered in api#100"
pr $OWNER/api 100 OPEN "acme-aaa: do the thing" acme-aaa-do-the-thing "why"
run_sweep --apply
expect_rc 0
expect_says "citing PRs not all merged — $OWNER/api#100(OPEN)"
expect_not_closed acme-aaa
finish

