# --- 8. what a run costs the shared GitHub budget (acme-mfhky) ----------
# Every session start and end on a machine sweeps, and every sweep spends the
# one token everything else on the machine spends too. These pin the cost, not
# just the verdicts: the open-PR index used to be rebuilt for EVERY close
# candidate (it was built inside $(...), so its "built" state died with the
# subshell), which is correct, silent, and 13 x 32 = ~420 REST calls a run
# where 32 would do.
multi_bead_fixture() {
    bead acme-aaa 2026-08-01T00:00:00Z "delivered in api#100"
    bead acme-bbb 2026-08-01T00:00:00Z "delivered in web#200"
    bead acme-ccc 2026-08-01T00:00:00Z "builds on api#100, delivered in api#300"
    bead acme-ddd 2026-08-01T00:00:00Z "no references yet"
    bead acme-eee 2026-08-01T00:00:00Z "in flight in api#400"
    pr $OWNER/api 100 MERGED "acme-aaa: one" acme-aaa-one "why" 2026-08-05T09:00:00Z
    pr $OWNER/web 200 MERGED "acme-bbb: two" acme-bbb-two "why" 2026-08-05T09:00:00Z
    pr $OWNER/api 300 MERGED "acme-ccc: three" acme-ccc-three "why" 2026-08-05T09:00:00Z
    pr $OWNER/api 400 OPEN "acme-eee: four" acme-eee-four "why"
    open_pr api 400 "acme-eee: four" acme-eee-four "why"
}

# Three close candidates over two repos, a PR two beads name, a bead with no
# references and one blocked on an open PR. Before the fix this run made 14 gh
# calls: 6 open-PR listings (3 candidates x 2 repos), 5 `gh pr view`, 3
# `gh search prs` (each of which also spent a hidden GraphQL query).
scenario "a multi-bead run lists each repo's open PRs once, not once per close candidate (acme-mfhky)"
multi_bead_fixture
run_sweep --apply
expect_rc 0
expect_closed acme-aaa
expect_closed acme-bbb
expect_closed acme-ccc
expect_not_closed acme-eee
expect_says "acme-eee: citing PRs not all merged — $OWNER/api#400(OPEN)"
expect_calls 1 "api's open PRs listed" core "" "^repos/$OWNER/api/pulls[?]state=open"
expect_calls 1 "web's open PRs listed" core "" "^repos/$OWNER/web/pulls[?]state=open"
expect_calls 1 "GraphQL batches for every PR any bead names (api#100 twice)" graphql
expect_calls 0 "per-PR REST lookups" core "" "^repos/[^?]*/pulls/[0-9]"
expect_calls 3 "pre-close searches, one per close candidate" search
expect_calls 6 "gh calls in all"
finish

# A number that is no PR at all — usually an issue the harvester read as one
# (acme-4ea0z) — is settled once per run: GraphQL's NOT_FOUND in the batch,
# then REST's definitive 404, then the cache. Not once per bead naming it.
# children_of runs inside $(...) for every swept bead, so a listing held in a
# shell variable was made again each time: 34 MB and a jq pass per bead, 280 times
# a sweep (acme-ywm6d.11). Same bug, same place to pin it as acme-mfhky above.
scenario "a multi-bead run dumps the tracker once, not once per swept bead (acme-ywm6d.11)"
bead acme-dm1 2026-08-01T00:00:00Z "delivered in api#101"
bead acme-dm2 2026-08-01T00:00:00Z "delivered in api#102"
bead acme-dm3 2026-08-01T00:00:00Z "delivered in api#103"
pr $OWNER/api 101 MERGED "acme-dm1: one" acme-dm1-one "why" 2026-08-05T09:00:00Z
pr $OWNER/api 102 MERGED "acme-dm2: two" acme-dm2-two "why" 2026-08-05T09:00:00Z
pr $OWNER/api 103 MERGED "acme-dm3: three" acme-dm3-three "why" 2026-08-05T09:00:00Z
run_sweep --apply
expect_rc 0
expect_closed acme-dm1
expect_closed acme-dm2
expect_closed acme-dm3
dumps=$(grep -c -e '^list .*--all' "$E2E_DIR/bd-calls.log")
[ "$dumps" = 1 ] || fail "bd list --all ran $dumps times for three beads, wanted 1"
finish

scenario "a tracker dump that failed is asked again, and is not read as no children"
bead acme-dr1 2026-08-01T00:00:00Z "delivered in api#111"
bead acme-dr2 2026-08-01T00:00:00Z "delivered in api#112" in_review
bead acme-dr3 2026-08-01T00:00:00Z "delivered in api#113"
child_row acme-dr2.1 acme-dr2 closed
pr $OWNER/api 111 MERGED "acme-dr1: one" acme-dr1-one "why" 2026-08-05T09:00:00Z
pr $OWNER/api 112 MERGED "acme-dr2.1: the child" acme-dr2.1-the-child "why" 2026-08-05T09:00:00Z
pr $OWNER/api 113 MERGED "acme-dr3: three" acme-dr3-three "why" 2026-08-05T09:00:00Z
: > "$E2E_DIR/fail-next-list-all"
run_sweep
expect_rc 0
dumps=$(grep -c -e '^list .*--all' "$E2E_DIR/bd-calls.log")
[ "$dumps" = 2 ] || fail "bd list --all ran $dumps times, wanted 2: the refused one, then one that is kept"
expect_silent_about "acme-dr2: MISRECORDED"
finish

scenario "a phantom ref named by two beads is asked about once"
bead acme-aaa 2026-08-01T00:00:00Z "mitigated by api#404"
bead acme-bbb 2026-08-01T00:00:00Z "see also api#404"
run_sweep --apply
expect_rc 0
expect_says "acme-aaa: no PR cites this bead — its only references are not pull requests in the repo they were attributed to (MISSING: $OWNER/api#404)"
expect_says "acme-bbb: no PR cites this bead — its only references are not pull requests in the repo they were attributed to (MISSING: $OWNER/api#404)"
expect_calls 1 "GraphQL batches" graphql
expect_calls 1 "REST lookups of the phantom" core 404 "^repos/$OWNER/api/pulls/404$"
expect_calls 2 "gh calls in all"
finish

# A parent parked on open children cannot close whatever GitHub says, and it
# stays parked for days. Asked last, that check made every sweep pay a search,
# its sleep and the whole open-PR listing for each such parent first: 24 of 40
# pre-close searches in a live dry run on 2026-09-29.
scenario "a parent parked on open children costs no search and no open-PR listing"
bead acme-par 2026-08-01T00:00:00Z "delivered in api#100" in_review
child_row acme-par.1 acme-par open
pr $OWNER/api 100 MERGED "acme-par: the parent's own part" acme-par-own-part \
    "why" 2026-08-05T09:00:00Z
run_sweep --apply
expect_rc 0
expect_says "acme-par: PRs merged ( $OWNER/api#100) but children still open — acme-par.1(open)"
expect_not_closed acme-par
expect_calls 0 "searches" search
expect_calls 0 "open-PR listings" core "" "pulls[?]state=open"
expect_calls 1 "gh calls in all (the PR lookup)"
finish

# The listings are conditional requests: a repo whose open PRs have not changed
# since the last sweep answers 304, which GitHub does not bill — and the
# remembered body must still be READ, or a 304 would be "no open PRs", the
# exact silent answer the cross-check exists to refuse (acme-vz559).
scenario "a second sweep re-lists unchanged open PRs as unbilled 304s, and still reads them"
bead acme-kdod 2026-08-17T08:00:00Z "started in api#100"
pr $OWNER/api 100 MERGED "acme-kdod: first half" acme-kdod-first-half \
    "why" 2026-08-17T12:00:00Z
open_pr api 1244 "acme-kdod: fix the sweep" acme-kdod-fix-the-sweep "why"
run_sweep --apply
expect_calls 2 "first run: full listings" core 200 "pulls[?]state=open"
: > "$E2E_DIR/gh-calls.log"
run_sweep --apply
expect_rc 0
expect_calls 2 "second run: both listings answered 304" core 304 "pulls[?]state=open"
expect_calls 0 "second run: billed listings" core 200 "pulls[?]state=open"
expect_says "citing PRs not all merged (open-PR cross-check) — $OWNER/api#1244(OPEN)"
expect_says "of them unbilled 304s"
expect_not_closed acme-kdod
finish

scenario "a listing that changed since the last sweep is read in full"
bead acme-aaa 2026-08-01T00:00:00Z "delivered in api#100"
pr $OWNER/api 100 MERGED "acme-aaa: do the thing" acme-aaa-do-the-thing \
    "why" 2026-08-05T09:00:00Z
run_sweep
expect_says "acme-aaa: would close"
open_pr api 1244 "acme-aaa: the rest" acme-aaa-the-rest "why"
: > "$E2E_DIR/gh-calls.log"
run_sweep
expect_calls 1 "the changed listing, fetched in full" core 200 "^repos/$OWNER/api/pulls[?]state=open"
expect_calls 1 "the unchanged one, a 304" core 304 "^repos/$OWNER/web/pulls[?]state=open"
expect_says "citing PRs not all merged (open-PR cross-check) — $OWNER/api#1244(OPEN)"
expect_silent_about "would close"
finish

# The budget itself. acme-gahlf, 2026-09-29: the core budget hit 5000/5000
# and every close candidate after that printed its own "open-PR cross-check
# could not be completed" line — 7 of 7 — which reads like a GitHub outage.
# At the reserve the sweep now stops asking, says so once, and leaves the rest.
scenario "a budget at its reserve stops the sweep: one line, and no GitHub call after it"
bead acme-aaa 2026-08-01T00:00:00Z "delivered in api#100"
bead acme-bbb 2026-08-01T00:00:00Z "delivered in web#200"
bead acme-ddd 2026-08-01T00:00:00Z "no references yet"
pr $OWNER/api 100 MERGED "acme-aaa: one" acme-aaa-one "why" 2026-08-05T09:00:00Z
pr $OWNER/web 200 MERGED "acme-bbb: two" acme-bbb-two "why" 2026-08-05T09:00:00Z
export E2E_RATE_CORE=100      # reserve is 10% of 5000; resets in an hour
run_sweep --apply
expect_rc 3
expect_says "stopped early to spare the shared GitHub token: GitHub core budget at 100/5000"
expect_says "2 bead(s) that still needed GitHub were not evaluated and are left as they were: acme-aaa acme-bbb"
expect_says "acme-ddd: no PR references found"
expect_silent_about "cross-check could not be completed"
expect_silent_about "search failed"
expect_not_closed acme-aaa
expect_not_closed acme-bbb
# The GraphQL prefetch, aaa's pre-close search, and the one listing whose
# headers said stop. Nothing after that.
expect_calls 3 "gh calls in all"
expect_calls 1 "open-PR listings" core "" "pulls[?]state=open"
finish

scenario "a search refused for budget waits out a reset seconds away, then carries on"
bead acme-aaa 2026-08-01T00:00:00Z "delivered in api#100"
pr $OWNER/api 100 MERGED "acme-aaa: do the thing" acme-aaa-do-the-thing \
    "why" 2026-08-05T09:00:00Z
export E2E_REFUSE_SEARCH=1 E2E_RATE_RESET_AT=$(( $(date +%s) + 10 ))
run_sweep --apply
expect_rc 0
expect_silent_about DEGRADED
expect_closed acme-aaa
expect_calls 1 "the refused search" search 403
expect_calls 1 "the retried search" search 200
awk '$1 >= 10 { found = 1 } END { exit !found }' "$E2E_DIR/slept" 2>/dev/null ||
    fail "the sweep did not wait for the search budget to reset (slept: $(tr '\n' ' ' < "$E2E_DIR/slept" 2>/dev/null))"
finish

scenario "a refusal whose reset is an hour away stops instead of sleeping on it"
bead acme-aaa 2026-08-01T00:00:00Z "delivered in api#100"
pr $OWNER/api 100 MERGED "acme-aaa: do the thing" acme-aaa-do-the-thing \
    "why" 2026-08-05T09:00:00Z
export E2E_REFUSE_SEARCH=1
run_sweep --apply
expect_rc 3
expect_says "GitHub search budget at 0/30"
expect_says "GitHub refused a call for budget (HTTP 403)"
expect_says "not evaluated and are left as they were: acme-aaa"
expect_not_closed acme-aaa
expect_calls 1 "searches: the refused one, not retried" search
! awk '$1 >= 20 { found = 1 } END { exit !found }' "$E2E_DIR/slept" 2>/dev/null ||
    fail "the sweep slept toward an hour-away reset (slept: $(tr '\n' ' ' < "$E2E_DIR/slept"))"
finish

echo
if [ "$FAILED" -eq 0 ]; then
    echo "all tests passed"
    exit 0
fi
echo "$FAILED test(s) failed"
exit 1
