expect_rc 5
expect_says "acme-xjprg: MISRECORDED"
finish

# The same shape on an in_progress bead is ordinary: work that has not been
# delivered yet legitimately has no delivering PR, and someone pasting a
# related PR for context is not a fault. Reporting it would make the loud
# lane fire constantly and stop being read.
scenario "the same shape on an in_progress bead is not reported"
bead acme-aaa 2026-08-19T08:00:00Z "context: https://github.com/$OWNER/api/pull/1484" in_progress
pr $OWNER/api 1484 MERGED "acme-5xr5: bearer-token parity" acme-5xr5-parity \
    "why" 2026-08-19T12:00:00Z
run_sweep --apply
expect_rc 0
expect_silent_about "MISRECORDED"
expect_says "no PR cites this bead"
finish

# acme-fluna: the MISRECORDED lane's false positive, and an expensive one.
# A parent split into children names the children's PRs, each of which
# delivery-cites a CHILD - which read as "delivers some OTHER bead" and made
# the sweep exit 5. That is a permanent, healthy state, so it fired every
# night; and exit 5 used to abort the nightly job before its push-back step,
# so each night's real closes were computed and thrown away (run 32686984270
# discarded four). The live bead was acme-9myv, whose own notes read
# "Parent stays open until .1 and .3 land. Do not close it on PR #13".
scenario "a parent whose PR delivers its own child is not MISRECORDED"
bead acme-par 2026-08-18T08:00:00Z "PR: https://github.com/$OWNER/api/pull/13" in_review
child_row acme-par.2 acme-par closed
pr $OWNER/api 13 MERGED "feat: telemetry (acme-par.2)" acme-par.2-telemetry \
    "Bead: acme-par.2" 2026-08-18T18:51:22Z
run_sweep --apply
expect_rc 0
expect_silent_about "MISRECORDED"
expect_says "acme-par: parent parked on its children"
expect_not_closed acme-par
finish

# The guard is scoped to THIS bead's children, not to dotted ids in general:
# an unrelated bead that merely spells its id with a dot is still a misrecord.
# Without that scoping the fix would silence the lane it was built for.
scenario "a PR delivering someone else's child is still MISRECORDED"
bead acme-par 2026-08-18T08:00:00Z "PR: https://github.com/$OWNER/api/pull/13" in_review
child_row acme-par.2 acme-par closed
pr $OWNER/api 13 MERGED "feat: telemetry (acme-other.2)" acme-other.2-telemetry \
    "Bead: acme-other.2" 2026-08-18T18:51:22Z
run_sweep --apply
expect_rc 5
expect_says "acme-par: MISRECORDED"
expect_not_closed acme-par
finish

# A bead whose real PR IS recorded closes as before - the new lane must not
# fire just because some other, non-citing PR is also mentioned.
scenario "a citing merged PR still closes even alongside a non-citing one"
bead acme-aaa 2026-08-19T08:00:00Z "context $OWNER/api#1484, delivered in $OWNER/api#100" in_review
pr $OWNER/api 1484 MERGED "acme-5xr5: something else" acme-5xr5-parity \
    "why" 2026-08-19T12:00:00Z
pr $OWNER/api 100 MERGED "acme-aaa: do the thing" acme-aaa-do-the-thing \
    "why" 2026-08-20T09:00:00Z
run_sweep --apply
expect_rc 0
expect_silent_about "MISRECORDED"
expect_closed acme-aaa
finish

# --- 6. one bead's verdict is its own ------------------------------------
# Every branch above ends in `continue`, not `exit`. A degraded bead that
# stopped the sweep would silently park everything behind it.
scenario "a degraded bead does not stop the sweep closing a later one"
bead acme-aaa 2026-08-01T00:00:00Z "delivered in api#100"
bead acme-bbb 2026-08-01T00:00:00Z "delivered in web#200"
pr $OWNER/api 100 MERGED "acme-aaa: do the thing" acme-aaa-do-the-thing \
    "why" 2026-08-05T09:00:00Z
pr $OWNER/web 200 MERGED "acme-bbb: do the other thing" acme-bbb-other \
    "why" 2026-08-05T09:00:00Z
pr_unresolvable $OWNER/api 100   # neither surface answers for #100 alone
run_sweep --apply
expect_rc 3
expect_says "acme-bbb: CLOSED"
expect_closed acme-bbb
expect_not_closed acme-aaa
finish

scenario "an empty in_review backlog is a clean no-op"
run_sweep --apply
expect_rc 0
expect_says "Nothing in in_progress/in_review"
finish

# --- 7. a PR delivers what its Bead: line lists (acme-d9x4e) ------------
# acme/beads#8 delivers acme-ouxcd and names acme-h34rf in its title and
# branch as the subject of a not-a-duplicate record. The nightly
# --search-citing pass finds it for both beads, since both ids are in it; only
# ouxcd may close. h34rf was in_progress and being worked when a dry run said
# "acme-h34rf: would close — acme/beads#8".
BEADS_8_TITLE="dup-check: record acme-eyrqq / acme-h34rf as distinct (acme-ouxcd)"
BEADS_8_BODY=$'**Bead: acme-ouxcd** — follow-up to #7, first real use of the allowlist it added.\n\nThe team filed `acme-h34rf` and the check flagged it against `acme-eyrqq` at 51%.\n'

scenario "a merged PR whose title only talks about a bead does not close it (beads#8)"
