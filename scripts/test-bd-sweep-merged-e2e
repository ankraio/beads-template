#!/usr/bin/env bash
# End-to-end tests for bd-sweep-merged's close path: the main-loop glue that
# decides which bead CLOSES, which is BLOCKED, and which is DEGRADED.
#
# scripts/test-bd-sweep-merged pins the helpers (cites_bead,
# merged_before_start, filter_citing_prs) by sourcing the script with
# BD_SWEEP_MERGED_LIB=1. The helpers have never been the whole risk. Every bug
# this script has shipped lived in the glue *around* them — which list a verdict
# lands in, which of those lists blocks a close, and whether a failed lookup is
# reported as "not merged" or as "could not tell":
#
#   - acme-hylim: a GraphQL outage made every `gh pr view` fail, the errors
#     were discarded, and beads whose PRs HAD merged were reported as "citing
#     PRs not all merged (UNKNOWN)". A whole sweep did nothing and read clean.
#   - acme-vz559: the pre-close search answered empty because the issue-search
#     index lagged, which is indistinguishable from "nothing cites this bead",
#     so an open delivering PR failed to block a close.
#   - acme-k2zxt: a merged PR that named the bead as a sibling lane it had
#     already shipped closed the bead while its real PR was still a draft.
#   - acme-it9d: follow-up beads named in a merged PR's body prose were closed
#     while their own PRs were open.
#   - acme-aeqb8: four PRs citing dotted child ids closed nothing.
#
# Every one of those was SILENT: the run exited 0 and printed plausible lines.
# Nothing but a test that drives the whole loop can see them, so this file puts
# a fake `bd` and a fake `gh` on PATH and runs the real script against crafted
# fixtures — the harness acme-vz559 used to reproduce its defect and verify its
# fix in two offline runs, committed rather than thrown away.
#
# THE MAINTENANCE CALL this pins gh's CLI invocation shape: the fake answers
# `gh api -i` on the four surfaces the script uses (the open-PR listing, one PR
# over REST, the issue search, batched GraphQL PR lookups) with real status
# lines, rate-limit headers and ETags, and the script's own jq runs on what it
# returns. If you change HOW bd-sweep-merged calls gh, this file must change
# with it — and it tells you so: an unmodelled call is recorded and fails the
# scenario rather than degrading quietly into a wrong verdict. That coupling is
# the price. It is worth paying here because the alternative is the five bugs
# above, each of which cost more to find in production than the whole harness
# costs to keep.
#
# The fake also logs every call, which is how section 8 pins what a run COSTS:
# acme-mfhky was a sweep that listed every sibling repo's open PRs once per
# close candidate instead of once per run — correct verdicts, silent, and
# ~420 REST calls a run against a budget every session on the machine shares.
# No verdict-only assertion could have seen it.
#
# Everything runs offline: no network, no GitHub token, no bd database. The
# workspace is a throwaway git repo whose origin URL supplies the owner.
#
# Run: scripts/test-bd-sweep-merged-e2e

set -uo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
SWEEP="$SCRIPT_DIR/bd-sweep-merged"
OWNER=acme

for tool in jq git; do
    command -v "$tool" >/dev/null || { echo "test-bd-sweep-merged-e2e: needs $tool" >&2; exit 1; }
done

FAILED=0
SC_N=0
SC_NAME=""
SC_FAILED_BEFORE=0
OUT=""
RC=0

pass() { printf '  ok   %s\n' "$1"; }
fail() { printf '  FAIL %s\n     %s\n' "$SC_NAME" "$1"; FAILED=$((FAILED + 1)); }

# --- the fake world -----------------------------------------------------
# One throwaway workspace for the whole run (it never varies); one fixture
# directory per scenario, addressed by the fakes through $E2E_DIR.

ROOT=$(mktemp -d "${TMPDIR:-/tmp}/bd-sweep-e2e.XXXXXX") || exit 1
trap 'rm -rf "$ROOT"' EXIT

SHIM="$ROOT/bin"
mkdir -p "$SHIM" "$ROOT/workspace/beads/.beads"
E2E_WORKSPACE="$ROOT/workspace/beads/.beads"
export E2E_WORKSPACE
git -c init.defaultBranch=main init -q "$ROOT/workspace/beads" >/dev/null 2>&1
git -C "$ROOT/workspace/beads" remote add origin "https://github.com/$OWNER/beads.git"

cat > "$SHIM/bd" <<'FAKE_BD'
#!/usr/bin/env bash
# fake bd — every subcommand bd-sweep-merged uses, and a loud failure for any
# it does not: an unmodelled call must fail the test, not silently answer "".
set -uo pipefail
printf '%s\n' "$*" >> "$E2E_DIR/bd-calls.log"
case "${1:-}" in
    where) printf '%s\n' "$E2E_WORKSPACE" ;;
    # Real bd hides closed issues from `bd list` unless --all is passed. The
    # fake has to model that, because a caller needing closed rows (children_of
    # wants a parent's ALREADY-DELIVERED children) gets a silently short answer
    # without the flag, not an error. A fake that ignored flags passed the
    # parked-parent tests while the live sweep still reported MISRECORDED.
    list)
        if printf '%s\n' "$@" | grep -qx -- --all; then
            # One refused listing, for the scenario where a failure must not be
            # remembered as an answer.
            if [ -e "$E2E_DIR/fail-next-list-all" ]; then
                rm -f "$E2E_DIR/fail-next-list-all"
                exit 1
            fi
            cat "$E2E_DIR/bd-list.json"
        else
            jq -c '[ .[] | select((.status // "") != "closed") ]' "$E2E_DIR/bd-list.json"
        fi ;;
    show)
        f="$E2E_DIR/bead-$2.json"
        [ -f "$f" ] || { echo "fake bd: no fixture for bead $2" >&2; exit 1; }
        cat "$f" ;;
    close)
        id=$2; shift 2
        # E2E_FAIL_CLOSE=1 models the 2026-08-30 shape: bd answers, refuses.
        if [ "${E2E_FAIL_CLOSE:-0}" = 1 ]; then
            echo "Error: database is locked by another dolt process" >&2
            exit 1
        fi
        # E2E_BLOCKED_CLOSE=1 models the acme-a17dx shape: bd answers with a
        # KNOWN state - the bead has an open dependency. Permanent until
        # someone acts, so it must not degrade the run.
        if [ "${E2E_BLOCKED_CLOSE:-0}" = 1 ]; then
            echo "cannot close $id: blocked by open issues [acme-zzz] (use --force to override)" >&2
            exit 1
        fi
        printf '%s %s\n' "$id" "$*" >> "$E2E_DIR/closed.log"
        echo "closed $id" ;;
    *) printf 'bd %s\n' "$*" >> "$E2E_DIR/unexpected.log"; exit 90 ;;
esac
FAKE_BD

cat > "$SHIM/gh" <<'FAKE_GH'
#!/usr/bin/env bash
# fake gh — `gh api -i` only, which is the one way bd-sweep-merged calls gh:
# a status line, headers (CRLF, as gh prints them) carrying the rate-limit
# budget, a blank line, the body. Four surfaces: the open-PR listing (REST,
# paged, with ETags), one PR (REST), the issue search (REST), and batched PR
# lookups (GraphQL). Anything else — `gh pr view`, `gh search prs`, a call
# without -i — is unmodelled and fails the scenario.
#
# Fixtures in $E2E_DIR:
#   pr-<owner>-<repo>-<n>.json  one PR, in GraphQL's pullRequest shape. Serves
#                               REST too, mapped here to REST's shape, so a
#                               scenario declares each PR once.
#   open-<owner>-<repo>.json    that repo's open PRs, REST shape. A MISSING file
#                               is a 404 — "no such repo under this owner".
#   search-<bead-id>.json       search hits; missing means no hits.
# Failure switches: E2E_FAIL_SEARCH, E2E_FAIL_GRAPHQL, E2E_FAIL_REST,
# E2E_FAIL_OPENPRS (HTTP 502), and unresolvable-<owner>-<repo>-<n> markers.
# Budget switches: E2E_RATE_<CORE|GRAPHQL|SEARCH> is that budget's remaining
# count (default: all but one), E2E_REFUSE_<...>=1 answers 403 for budget.
# Both hold only until E2E_RATE_RESET_AT on the virtual clock (below).
#
# Every call is appended to $E2E_DIR/gh-calls.log as
# "<resource> <status> <what>", which is what the call-count scenarios read.
set -uo pipefail

unexpected() { printf 'gh %s\n' "$*" >> "$E2E_DIR/unexpected.log"; exit 90; }

[ "${1:-}" = api ] || unexpected "$@"
shift
include=0; path=""; query=""; if_none_match=""
while [ $# -gt 0 ]; do
    case $1 in
        -i) include=1 ;;
        -H) case $2 in If-None-Match:\ *) if_none_match=${2#If-None-Match: } ;; *) unexpected api -H "$2" ;; esac; shift ;;
        -f) case $2 in query=*) query=${2#query=} ;; *) unexpected api -f "$2" ;; esac; shift ;;
        -*) unexpected api "$1" ;;
        *) path=$1 ;;
    esac
    shift
done
[ "$include" = 1 ] || unexpected api "$path" "(without -i: no budget headers)"

# The virtual clock: real time plus every second the fake sleep has slept, so a
# scenario can make the script wait out a reset without the suite waiting.
slept=$(awk '{ s += $1 } END { printf "%d", s }' "$E2E_DIR/slept" 2>/dev/null || echo 0)
now=$(( $(date +%s) + ${slept:-0} ))
reset_at=${E2E_RATE_RESET_AT:-$(( $(date +%s) + 3600 ))}

respond() {
    # respond <status> <resource> <body-file|""> [extra header]
    local status=$1 resource=$2 body=$3 extra=${4:-} limit remaining var
    case $resource in search) limit=30 ;; *) limit=5000 ;; esac
    var=E2E_RATE_$(printf '%s' "$resource" | tr '[:lower:]' '[:upper:]')
    remaining=${!var:-$((limit - 1))}
    [ "$now" -ge "$reset_at" ] && remaining=$((limit - 1))
    printf '%s %s %s\n' "$resource" "$status" "${path:-graphql}" >> "$E2E_DIR/gh-calls.log"
    printf 'HTTP/2.0 %s X\n' "$status"
    printf 'Content-Type: application/json; charset=utf-8\r\n'
    printf 'X-Ratelimit-Limit: %s\r\nX-Ratelimit-Remaining: %s\r\n' "$limit" "$remaining"
    printf 'X-Ratelimit-Reset: %s\r\nX-Ratelimit-Resource: %s\r\n' "$reset_at" "$resource"
    [ -n "$extra" ] && printf '%s\r\n' "$extra"
    printf '\r\n'
    [ -n "$body" ] && cat "$body"
    case $status in 2??) exit 0 ;; *) exit 1 ;; esac
}

refused() {
    # A 403 for budget, while the scenario's refusal switch holds.
    local var
    var=E2E_REFUSE_$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')
    [ "${!var:-0}" = 1 ] && [ "$now" -lt "$reset_at" ]
}

tmp=$(mktemp "$E2E_DIR/gh-body.XXXXXX")
trap 'rm -f "$tmp"' EXIT

if [ "$path" = graphql ]; then
    if refused graphql; then
        echo '{"message": "API rate limit exceeded for user ID 1."}' > "$tmp"
        E2E_RATE_GRAPHQL=0 respond 403 graphql "$tmp"
    fi
    refs=$(printf '%s' "$query" | grep -oE 'p[0-9]+: repository\(owner: "[^"]+", name: "[^"]+"\) \{ pullRequest\(number: [0-9]+\)' |
        sed -E 's/^(p[0-9]+): repository\(owner: "([^"]+)", name: "([^"]+)"\) \{ pullRequest\(number: ([0-9]+)\)$/\1 \2 \3 \4/')
    [ -n "$refs" ] || unexpected api graphql "(no pullRequest aliases in: $query)"
    [ "${E2E_FAIL_GRAPHQL:-0}" = 1 ] && { echo '{"message": "Something went wrong"}' > "$tmp"; respond 502 graphql "$tmp"; }
    data='{}'; errors='[]'
    while read -r alias o r n; do
        # One PR neither surface will answer takes its whole batch down, as an
        # outage would; the script then asks about each PR alone.
        [ -f "$E2E_DIR/unresolvable-$o-$r-$n" ] && { echo '{}' > "$tmp"; respond 502 graphql "$tmp"; }
        f="$E2E_DIR/pr-$o-$r-$n.json"
        if [ -f "$f" ]; then
            data=$(jq -c --arg a "$alias" --slurpfile pr "$f" '. + {($a): {pullRequest: $pr[0]}}' <<<"$data")
        else
            data=$(jq -c --arg a "$alias" '. + {($a): {pullRequest: null}}' <<<"$data")
            errors=$(jq -c --arg a "$alias" --arg n "$n" \
                '. + [{type: "NOT_FOUND", path: [$a, "pullRequest"], message: ("Could not resolve to a PullRequest with the number of " + $n + ".")}]' <<<"$errors")
        fi
    done <<<"$refs"
    jq -nc --argjson d "$data" --argjson e "$errors" \
        'if ($e | length) > 0 then {data: $d, errors: $e} else {data: $d} end' > "$tmp"
    respond 200 graphql "$tmp"
fi

case "$path" in
    search/issues\?*)
        refused search && { echo '{"message": "API rate limit exceeded for user ID 1."}' > "$tmp"; E2E_RATE_SEARCH=0 respond 403 search "$tmp"; }
        [ "${E2E_FAIL_SEARCH:-0}" = 1 ] && { echo '{"message": "Bad Gateway"}' > "$tmp"; respond 502 search "$tmp"; }
        q=${path#*q=}; q=${q%%&*}
        q=$(printf '%b' "${q//%/\\x}")
        # The script sends "( <bead-id> ) type:pr user:<owner>", as gh does.
        case "$q" in "( "*" ) type:pr user:"*) ;; *) unexpected api "$path" "(query shape: $q)" ;; esac
        id=${q#( }; id=${id%% )*}
        f="$E2E_DIR/search-$id.json"
        if [ -f "$f" ]; then
            jq -c '{total_count: length, incomplete_results: false,
                    items: map({number, repository_url: ("https://api.github.com/repos/" + .repository.nameWithOwner)})}' "$f" > "$tmp"
        else
            echo '{"total_count": 0, "incomplete_results": false, "items": []}' > "$tmp"
        fi
        respond 200 search "$tmp" ;;
    repos/*/pulls\?state=open\&per_page=100\&page=*)
        refused core && { echo '{"message": "API rate limit exceeded for user ID 1."}' > "$tmp"; E2E_RATE_CORE=0 respond 403 core "$tmp"; }
        or=${path#repos/}; or=${or%%/pulls*}; page=${path##*page=}
        [ "${E2E_FAIL_OPENPRS:-0}" = 1 ] && { echo '{"message": "Bad Gateway"}' > "$tmp"; respond 502 core "$tmp"; }
        f="$E2E_DIR/open-${or//\//-}.json"
        [ -f "$f" ] || { echo '{"message": "Not Found"}' > "$tmp"; respond 404 core "$tmp"; }
        jq -c --argjson p "$page" '.[(($p - 1) * 100):($p * 100)]' "$f" > "$tmp"
        etag="W/\"$(cksum < "$tmp" | awk '{print $1}')\""
        if [ -n "$if_none_match" ] && [ "$if_none_match" = "$etag" ]; then
            : > "$tmp"
            respond 304 core "" "ETag: $etag"
        fi
        respond 200 core "$tmp" "ETag: $etag" ;;
    repos/*/pulls/[0-9]*)
        refused core && { echo '{"message": "API rate limit exceeded for user ID 1."}' > "$tmp"; E2E_RATE_CORE=0 respond 403 core "$tmp"; }
        rest=${path#repos/}; or=${rest%/pulls/*}; num=${rest##*/}
        if [ "${E2E_FAIL_REST:-0}" = 1 ] || [ -f "$E2E_DIR/unresolvable-${or//\//-}-$num" ]; then
            echo '{"message": "Bad Gateway"}' > "$tmp"
            respond 502 core "$tmp"
        fi
        f="$E2E_DIR/pr-${or//\//-}-$num.json"
        [ -f "$f" ] || { echo '{"message": "Not Found"}' > "$tmp"; respond 404 core "$tmp"; }
        # GraphQL shape -> REST shape: REST reports merged separately from
        # state, and folding the two back is the script's job.
        jq -c '{merged: (.state == "MERGED"),
                state: (if .state == "MERGED" then "closed" else (.state | ascii_downcase) end),
                title, body, head: {ref: .headRefName}, merged_at: .mergedAt}' "$f" > "$tmp"
        respond 200 core "$tmp" ;;
    *) unexpected api "$path" ;;
esac
FAKE_GH

# The sweep sleeps ~2.2s between search calls for GitHub's rate limit, 2s
# between pr_lookup retries, and until a budget resets when it is at its
# reserve. There is no rate limit here, and a suite that really slept would be
# too slow to run before every ship — which is the same as not having one. So
# sleeping only advances the fake gh's virtual clock.
cat > "$SHIM/sleep" <<'FAKE_SLEEP'
#!/usr/bin/env bash
printf '%s\n' "${1:-0}" >> "$E2E_DIR/slept"
exit 0
FAKE_SLEEP

chmod +x "$SHIM/bd" "$SHIM/gh" "$SHIM/sleep"

# --- fixture builders ---------------------------------------------------

scenario() {
    SC_NAME=$1
    SC_N=$((SC_N + 1))
    E2E_DIR="$ROOT/sc-$SC_N"
    export E2E_DIR
    mkdir -p "$E2E_DIR"
    : > "$E2E_DIR/closed.log"
    : > "$E2E_DIR/unexpected.log"
    printf '[]' > "$E2E_DIR/bd-list.json"
    BEAD_IDS=()
    BEAD_ROWS=()
    export BD_SWEEP_REPOS="api web"
    # Never the real ~/.cache: the ETag cache is per scenario unless a
    # scenario deliberately shares it between two runs.
    export BD_SWEEP_CACHE_DIR="$E2E_DIR/cache"
    export E2E_FAIL_SEARCH=0 E2E_FAIL_GRAPHQL=0 E2E_FAIL_REST=0 E2E_FAIL_OPENPRS=0 E2E_FAIL_CLOSE=0 E2E_BLOCKED_CLOSE=0
    unset E2E_RATE_CORE E2E_RATE_GRAPHQL E2E_RATE_SEARCH E2E_REFUSE_CORE E2E_REFUSE_GRAPHQL E2E_REFUSE_SEARCH
    unset BD_SWEEP_RATE_RESERVE_PCT BD_SWEEP_RATE_WAIT
    export E2E_RATE_RESET_AT=$(( $(date +%s) + 3600 ))
    : > "$E2E_DIR/gh-calls.log"
    : > "$E2E_DIR/bd-calls.log"
    rm -f "$E2E_DIR/fail-next-list-all"
    # Both candidate repos exist and have no open PRs unless a scenario says so.
    repo_open api
    repo_open web
    SC_FAILED_BEFORE=$FAILED
}

bead() {
    # bead <id> <started_at|""> <description> [status] [parent]
    # Status defaults to in_progress, which is what a bead whose work has not
    # been delivered yet actually is. Only the MISRECORDED report reads it -
    # that claim is about a bead asserting "delivered, awaiting merge" - so
    # scenarios about anything else are unaffected by the default.
    # Parent defaults to none. It appears only in the `bd list` view, which is
    # where the script reads parentage from (never from the child's own
    # record, and never from the id shape - see children_of).
    jq -nc --arg t "$1" --arg d "$3" --arg s "$2" --arg st "${4:-in_progress}" \
        '[{title: ("bead " + $t), description: $d, comments: [], status: $st,
           started_at: (if $s == "" then null else $s end)}]' \
        > "$E2E_DIR/bead-$1.json"
    BEAD_IDS+=("$1")
    BEAD_ROWS+=("$(jq -nc --arg id "$1" --arg st "${4:-in_progress}" --arg p "${5:-}" \
        '{id: $id, status: $st, parent: (if $p == "" then null else $p end)}')")
    printf '%s\n' "${BEAD_ROWS[@]}" | jq -sc . > "$E2E_DIR/bd-list.json"
}

# A bead that exists only as a row in `bd list` - a child the sweep never
# sweeps itself (it is closed, or not in_review/in_progress) but whose
# parentage the parked-parent check has to be able to see.
child_row() {
    # child_row <id> <parent> [status]
    BEAD_ROWS+=("$(jq -nc --arg id "$1" --arg p "$2" --arg st "${3:-closed}" \
        '{id: $id, status: $st, parent: $p}')")
    printf '%s\n' "${BEAD_ROWS[@]}" | jq -sc . > "$E2E_DIR/bd-list.json"
}

pr() {
    # pr <owner/repo> <number> <MERGED|OPEN|CLOSED> <title> <branch> <body> [mergedAt]
    jq -nc --arg s "$3" --arg t "$4" --arg h "$5" --arg b "$6" --arg m "${7:-}" \
        '{state: $s, title: $t, body: $b, headRefName: $h,
          mergedAt: (if $m == "" then null else $m end)}' \
        > "$E2E_DIR/pr-${1//\//-}-$2.json"
}

repo_open() {
    # repo_open <repo> — the repo exists and has no open PRs
    printf '[]' > "$E2E_DIR/open-$OWNER-$1.json"
}

pr_unresolvable() {
    # pr_unresolvable <owner/repo> <number> — GitHub answers neither surface for
    # this one PR (the rest of the run is unaffected)
    : > "$E2E_DIR/unresolvable-${1//\//-}-$2"
}

repo_absent() {
    # repo_absent <repo> — a sibling checkout GitHub answers 404 for
    rm -f "$E2E_DIR/open-$OWNER-$1.json"
}

open_pr() {
    # open_pr <repo> <number> <title> <branch> <body>
    f="$E2E_DIR/open-$OWNER-$1.json"
    jq -c --argjson n "$2" --arg t "$3" --arg h "$4" --arg b "$5" \
        '. + [{number: $n, title: $t, body: $b, head: {ref: $h}}]' "$f" > "$f.tmp" &&
        mv -f "$f.tmp" "$f"
}

search_hit() {
    # search_hit <bead-id> <owner/repo> <number>
    f="$E2E_DIR/search-$1.json"
    [ -f "$f" ] || printf '[]' > "$f"
    jq -c --arg r "$2" --argjson n "$3" \
        '. + [{number: $n, repository: {nameWithOwner: $r}}]' "$f" > "$f.tmp" &&
        mv -f "$f.tmp" "$f"
}

run_sweep() {
    OUT=$(PATH="$SHIM:$PATH" "$SWEEP" "$@" 2>&1)
    RC=$?
}

# --- assertions ---------------------------------------------------------

expect_rc() {
    [ "$RC" = "$1" ] || fail "exited $RC, expected $1"
}

expect_says() {
    case "$OUT" in *"$1"*) ;; *) fail "output does not contain '$1'" ;; esac
}

expect_silent_about() {
    case "$OUT" in *"$1"*) fail "output contains '$1' and must not" ;; esac
}

expect_closed() {
    grep -q "^$1 " "$E2E_DIR/closed.log" || fail "$1 was not closed"
}

expect_not_closed() {
    ! grep -q "^$1 " "$E2E_DIR/closed.log" || fail "$1 was CLOSED and must not be"
}

calls() {
    # calls [<resource> [<status> [<what-regex>]]] — how many gh calls this
    # scenario made that match, from the fake's call log.
    awk -v r="${1:-}" -v s="${2:-}" -v w="${3:-}" '
        (r == "" || $1 == r) && (s == "" || $2 == s) && (w == "" || $3 ~ w) { n++ }
        END { print n + 0 }' "$E2E_DIR/gh-calls.log"
}

expect_calls() {
    # expect_calls <n> <description> [<resource> [<status> [<what-regex>]]]
    local want=$1 what=$2 got
    shift 2
    got=$(calls "$@")
    [ "$got" = "$want" ] || fail "$what: $got gh call(s), expected $want — log: $(tr '\n' ';' < "$E2E_DIR/gh-calls.log")"
}

finish() {
    if [ -s "$E2E_DIR/unexpected.log" ]; then
        fail "the fakes saw a call they do not model: $(tr '\n' ';' < "$E2E_DIR/unexpected.log")"
    fi
    if [ "$FAILED" = "$SC_FAILED_BEFORE" ]; then
        pass "$SC_NAME"
    else
        printf '     --- sweep output (rc=%s) ---\n' "$RC"
        printf '%s\n' "$OUT" | sed 's/^/     | /'
    fi
    return 0
}

echo "bd-sweep-merged close-path tests (fake bd + fake gh)"

# --- 1. the close, end to end -------------------------------------------
scenario "a bead whose only citing PR merged is closed"
bead acme-aaa 2026-08-01T00:00:00Z "delivered in api#100"
pr $OWNER/api 100 MERGED "acme-aaa: do the thing" acme-aaa-do-the-thing \
    "why" 2026-08-05T09:00:00Z
run_sweep --apply
expect_rc 0
expect_says "acme-aaa: CLOSED — $OWNER/api#100"
expect_closed acme-aaa
finish

scenario "a close bd rejects is DEGRADED and exits 3, never reported CLOSED"
bead acme-aaa 2026-08-01T00:00:00Z "delivered in api#100"
pr $OWNER/api 100 MERGED "acme-aaa: do the thing" acme-aaa-do-the-thing \
    "why" 2026-08-05T09:00:00Z
E2E_FAIL_CLOSE=1
run_sweep --apply
expect_rc 3
expect_says "acme-aaa: DEGRADED — bd close failed"
expect_silent_about "acme-aaa: CLOSED"
expect_not_closed acme-aaa
finish

scenario "a close bd refuses on an open dependency is reported, not DEGRADED"
# acme-a17dx: bd ANSWERS here - the bead is blocked by an open dependency,
# which is a known state and permanent until someone acts on it. Reporting it
# as DEGRADED ("re-run when bd answers") made the nightly exit 3 on the same
# two beads every night, taking --search-citing - the only direction-1 rescue
# lane - down with it. A dependency block belongs with "children still open".
bead acme-aaa 2026-08-01T00:00:00Z "delivered in api#100"
pr $OWNER/api 100 MERGED "acme-aaa: do the thing" acme-aaa-do-the-thing \
    "why" 2026-08-05T09:00:00Z
E2E_BLOCKED_CLOSE=1
run_sweep --apply
expect_rc 0
expect_says "acme-aaa: PRs merged"
expect_says "blocked by open dependencies — acme-zzz"
expect_silent_about DEGRADED
expect_silent_about "acme-aaa: CLOSED"
expect_not_closed acme-aaa
finish

scenario "a dry run reports the close and closes nothing"
bead acme-aaa 2026-08-01T00:00:00Z "delivered in api#100"
pr $OWNER/api 100 MERGED "acme-aaa: do the thing" acme-aaa-do-the-thing \
    "why" 2026-08-05T09:00:00Z
run_sweep
expect_rc 0
expect_says "would close"
expect_says "dry run; pass --apply"
expect_not_closed acme-aaa
finish

# --- 2. the open-PR cross-check, which is why it exists ------------------
# acme-vz559's exact shape: a merged PR the bead references, a search that
# answers empty because the index lags, and the real delivering PR still open.
scenario "an open PR the search missed blocks the close"
bead acme-kdod 2026-08-17T08:00:00Z "started in api#100"
pr $OWNER/api 100 MERGED "acme-kdod: first half" acme-kdod-first-half \
    "why" 2026-08-17T12:00:00Z
open_pr api 1244 "acme-kdod: fix the sweep" acme-kdod-fix-the-sweep "why"
run_sweep --apply
expect_rc 0
expect_says "citing PRs not all merged (open-PR cross-check) — $OWNER/api#1244(OPEN)"
expect_says "treating its empty answer as incomplete"
expect_not_closed acme-kdod
finish

scenario "an open PR that only names the bead in prose does not block"
bead acme-aaa 2026-08-01T00:00:00Z "delivered in api#100"
pr $OWNER/api 100 MERGED "acme-aaa: do the thing" acme-aaa-do-the-thing \
    "why" 2026-08-05T09:00:00Z
open_pr api 1244 "something else" other-branch \
    "Follow-up beads: acme-aaa covers the rest."
run_sweep --apply
expect_rc 0
expect_closed acme-aaa
finish

# The index is a snapshot taken at the run's first close candidate. A PR that
# merged after it was taken already got a fresh per-PR lookup, and that is the
# newer answer — otherwise a bead would block on its own delivering PR.
scenario "a PR already found merged does not block itself from the stale index"
bead acme-aaa 2026-08-01T00:00:00Z "delivered in api#100"
pr $OWNER/api 100 MERGED "acme-aaa: do the thing" acme-aaa-do-the-thing \
    "why" 2026-08-05T09:00:00Z
open_pr api 100 "acme-aaa: do the thing" acme-aaa-do-the-thing "why"
run_sweep --apply
expect_rc 0
expect_closed acme-aaa
finish

scenario "an open-PR list GitHub will not answer is DEGRADED, never a close"
bead acme-aaa 2026-08-01T00:00:00Z "delivered in api#100"
pr $OWNER/api 100 MERGED "acme-aaa: do the thing" acme-aaa-do-the-thing \
    "why" 2026-08-05T09:00:00Z
export E2E_FAIL_OPENPRS=1
run_sweep --apply
expect_rc 3
expect_says "DEGRADED — would close, but the open-PR cross-check could not be completed"
expect_not_closed acme-aaa
finish

# A repo GitHub 404s is a sibling checkout from somewhere else, not a broken
# index: it hosts none of our PRs, so the rest of the cross-check still stands.
scenario "a 404 repo in the candidate list does not degrade the cross-check"
bead acme-aaa 2026-08-01T00:00:00Z "delivered in api#100"
pr $OWNER/api 100 MERGED "acme-aaa: do the thing" acme-aaa-do-the-thing \
    "why" 2026-08-05T09:00:00Z
repo_absent web
