#!/usr/bin/env bash
# Tests for checkout-staleness: the verdict boundary, the default-branch
# resolution, what counts as a checkable repo, and one end-to-end run over a
# throwaway workspace. Everything runs on temp repos; no network.
#
# Run: scripts/test-checkout-staleness
set -uo pipefail
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=/dev/null
CHECKOUT_STALENESS_LIB=1 . "$SCRIPT_DIR/checkout-staleness"
FAILED=0
pass() { printf '  ok   %s\n' "$1"; }
fail() { printf '  FAIL %s\n     %s\n' "$1" "$2"; FAILED=$((FAILED + 1)); }
expect() { # expect <name> <want> <got>
    if [ "$2" = "$3" ]; then pass "$1"; else fail "$1" "got '$3', expected '$2'"; fi
}
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@example.invalid GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@example.invalid
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null

echo "checkout-staleness tests"

# --- 1. the verdict boundary --------------------------------------------------
expect "100 behind at max 100 is fresh (the threshold is exclusive)" fresh "$(verdict 100 100)"
expect "101 behind at max 100 is stale" stale "$(verdict 101 100)"
expect "0 behind is fresh" fresh "$(verdict 0 100)"

# --- 2. a workspace: one stale clone, one fresh clone, one bare, one local ---
WS="$TMP/ws"; mkdir -p "$WS"
ORIGIN="$TMP/origin.git"
git init -q -b main "$TMP/seed"
git -C "$TMP/seed" commit -q --allow-empty -m seed
git clone -q --bare "$TMP/seed" "$ORIGIN"
git clone -q "$ORIGIN" "$WS/stale"
git clone -q "$ORIGIN" "$WS/fresh"
# origin moves on by 120 commits; both clones fetch, only refs move.
git clone -q "$ORIGIN" "$TMP/pusher"
for i in $(seq 1 120); do git -C "$TMP/pusher" commit -q --allow-empty -m "c$i"; done
git -C "$TMP/pusher" push -q origin main
git -C "$WS/stale" fetch -q origin
git -C "$WS/fresh" fetch -q origin && git -C "$WS/fresh" merge -q --ff-only origin/main
git clone -q --bare "$ORIGIN" "$WS/bare"
git init -q -b main "$WS/local" && git -C "$WS/local" commit -q --allow-empty -m local
# a linked worktree of the stale clone: task-scoped, so never a finding
git -C "$WS/stale" worktree add -q "$WS/linked" -b linked

expect "behind_count sees the 120 unfetched-into-HEAD commits" 120 "$(behind_count "$WS/stale" main)"
expect "behind_count is 0 after a fast-forward" 0 "$(behind_count "$WS/fresh" main)"
expect "default_branch reads origin/HEAD" main "$(default_branch "$WS/stale")"
git -C "$WS/stale" remote set-head origin -d
expect "default_branch falls back to main when origin/HEAD is unset" main "$(default_branch "$WS/stale")"
expect "a clone with an origin is checkable" yes "$(checkable "$WS/stale" && echo yes || echo no)"
expect "a bare repo is skipped" no "$(checkable "$WS/bare" && echo yes || echo no)"
expect "a repo with no origin is skipped" no "$(checkable "$WS/local" && echo yes || echo no)"
expect "a linked worktree (.git file) is skipped" no "$(checkable "$WS/linked" && echo yes || echo no)"

# --- 3. end to end ----------------------------------------------------------
out=$("$SCRIPT_DIR/checkout-staleness" --workspace "$WS" --max 100)
case "$out" in
    *"stale is 120 commits behind origin/main"*) pass "stale clone is reported with its count" ;;
    *) fail "stale clone is reported with its count" "$out" ;;
esac
case "$out" in
    *"fresh is 0 behind"*) pass "fresh clone is listed as ok in the full report" ;;
    *) fail "fresh clone is listed as ok in the full report" "$out" ;;
esac
case "$out" in
    *linked*) fail "a linked worktree never appears in the report" "$out" ;;
    *) pass "a linked worktree never appears in the report" ;;
esac
quiet=$("$SCRIPT_DIR/checkout-staleness" --workspace "$WS" --max 100 --quiet)
case "$quiet" in
    *fresh*) fail "--quiet omits fresh clones" "$quiet" ;;
    *stale*) pass "--quiet keeps stale clones" ;;
    *) fail "--quiet keeps stale clones" "$quiet" ;;
esac
silent=$("$SCRIPT_DIR/checkout-staleness" --workspace "$WS" --max 200 --quiet)
expect "--quiet prints nothing when every checkout is within the threshold" "" "$silent"
json=$("$SCRIPT_DIR/checkout-staleness" --workspace "$WS" --max 100 --json)
expect "--json counts one finding" 1 "$(printf '%s' "$json" | jq '.count')"
expect "--json carries the repo and its behind count" "stale 120" "$(printf '%s' "$json" | jq -r '.findings[0] | "\(.repo) \(.behind)"')"

if [ "$FAILED" -gt 0 ]; then echo "$FAILED test(s) failed"; exit 1; fi
echo "all tests passed"
