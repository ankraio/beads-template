{
  "env": {
    "BEADS_DIR": "/ABSOLUTE/PATH/TO/WORKSPACE/beads/.beads"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/ABSOLUTE/PATH/TO/WORKSPACE/beads/scripts/beads-precreate-guard.py",
            "timeout": 30,
            "statusMessage": "Checking for an existing bead"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd /ABSOLUTE/PATH/TO/WORKSPACE/beads && bd prime --hook-json"
          },
          {
            "type": "command",
            "command": "cd /ABSOLUTE/PATH/TO/WORKSPACE/beads && scripts/bd-health --quiet",
            "timeout": 30,
            "statusMessage": "Checking beads tracker health"
          },
          {
            "type": "command",
            "command": "cd /ABSOLUTE/PATH/TO/WORKSPACE/beads && { [ -x scripts/checkout-staleness ] && scripts/checkout-staleness --quiet; } || true",
            "timeout": 30,
            "statusMessage": "Checking shared checkouts against origin"
          },
          {
            "type": "command",
            "command": "sh /ABSOLUTE/PATH/TO/WORKSPACE/beads/templates/beads-sync.sh /ABSOLUTE/PATH/TO/WORKSPACE/beads",
            "async": true,
            "timeout": 90,
            "statusMessage": "Syncing beads with remote"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh /ABSOLUTE/PATH/TO/WORKSPACE/beads/templates/beads-sync.sh /ABSOLUTE/PATH/TO/WORKSPACE/beads --quick",
            "timeout": 60,
            "statusMessage": "Syncing beads to remote"
          }
        ]
      }
    ]
  }
}
